# Copy to .env next to docker-compose.yml
# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
VMP_JWT_SECRET_KEY=
VMP_SITE_TIMEZONE=Europe/Paris
# Optional, demo data only: set a password of at least 12 characters to create demo users.
# Leave empty in real deployments.
VMP_SEED_PASSWORD=
