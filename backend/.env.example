# Copy to .env for local development (never commit real secrets).
VMP_ENVIRONMENT=development
VMP_DATABASE_URL=sqlite:///./data/vmp.db
# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
VMP_JWT_SECRET_KEY=
VMP_ACCESS_TOKEN_EXPIRE_MINUTES=60
VMP_SITE_TIMEZONE=Europe/Paris
VMP_LOG_LEVEL=INFO
# Only needed when the frontend is served from another origin without the Vite proxy.
VMP_CORS_ORIGINS=[]
# Used by `python -m app.seed` for all demo users. Choose your own (at least 12 characters).
VMP_SEED_PASSWORD=
